# top-most EditorConfig file
root = true

# 모든 파일 기본 설정
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# TypeScript/JavaScript 파일
[*.{ts,tsx,js,jsx}]
indent_style = tab
indent_size = 4
tab_width = 4

# JSON 파일 (스페이스 사용)
[*.json]
indent_style = space
indent_size = 2

# YAML 파일 (스페이스 사용)
[*.{yml,yaml}]
indent_style = space
indent_size = 2

# Markdown 파일
[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false
