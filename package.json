{
	"name": "card-navigator",
	"version": "1.0.0",
	"description": "Navigate your notes with a beautiful card-based interface",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "jest",
		"test:watch": "jest --watch",
		"test:coverage": "jest --coverage",
		"lint": "eslint src --ext .ts",
		"lint:fix": "eslint src --ext .ts --fix"
	},
	"keywords": [
		"obsidian",
		"plugin",
		"navigation",
		"cards"
	],
	"author": "wakeyi",
	"license": "MIT",
	"devDependencies": {
		"@types/jest": "^30.0.0",
		"@types/node": "^20.0.0",
		"@typescript-eslint/eslint-plugin": "^6.0.0",
		"@typescript-eslint/parser": "^6.0.0",
		"builtin-modules": "^3.3.0",
		"esbuild": "^0.27.0",
		"jest": "^29.7.0",
		"jest-environment-jsdom": "^29.5.0",
		"obsidian": "latest",
		"ts-jest": "^29.4.5",
		"tslib": "^2.6.0",
		"typescript": "^5.0.0"
	}
}
